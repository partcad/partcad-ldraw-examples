# castle/spire: one of the pieces 'castle' is assembled from, built once here
# and placed wherever it occurs. The piece's own origin is the first brick
# of it, which is why that one says no coordinates: where it goes is for
# whatever places the piece to decide. Everything after it names the brick
# and the stud it goes on.
links:
  - part: //pub/universe/lego/ldraw/Cone:3942b
    name: spire_s0
  - part: //pub/universe/lego/ldraw/Cone:3942b
    name: spire_s1
    location: [[0.0, 19.2, 0.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Cone:4589
    name: spire_s2
    connect:
      with: //pub/universe/lego:anti-stud
      withInstance: c0r0
      name: spire_s1
      to: //pub/universe/lego:stud
      toInstance: c0r0
  - part: //pub/universe/lego/ldraw/Cone:4589
    name: spire_s3
    connect:
      with: //pub/universe/lego:anti-stud
      withInstance: c0r0
      name: spire_s2
      to: //pub/universe/lego:stud
      toInstance: c0r0
