# castle/buttress: one of the pieces 'castle' is assembled from, built once here
# and placed wherever it occurs. Coordinates are this piece's own - its
# origin is the stud it starts at - which is what lets one file stand for
# every instance of it.
links:
  {% for i in range(8) %}
  - part: //pub/universe/lego/ldraw/Brick:3005
    name: butt_c{{ i }}
    location: [[0.0, {{ (9.6 + i * 9.6) | round(3) }}, 0.0], [0, 1, 0], 0]
  {% endfor %}
  - part: //pub/universe/lego/ldraw/Cone:4589
    name: butt_p
    location: [[0.0, 86.4, 0.0], [0, 1, 0], 0]
