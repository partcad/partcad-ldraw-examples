# castle/keep-courses: one of the pieces 'castle' is assembled from, built once here
# and placed wherever it occurs. Coordinates are this piece's own - its
# origin is the stud it starts at - which is what lets one file stand for
# every instance of it.
links:
  - part: //pub/universe/lego/ldraw/Brick:3010
    name: kS_c0_0
    location: [[12.0, 9.6, 0.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3004
    name: kS_c0_1
    location: [[36.0, 9.6, 0.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3010
    name: kN_c0_0
    location: [[12.0, 9.6, 40.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3004
    name: kN_c0_1
    location: [[36.0, 9.6, 40.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3010
    name: kW_c0_0
    location: [[0.0, 9.6, 20.0], [0, 1, 0], 90]
  - part: //pub/universe/lego/ldraw/Brick:3010
    name: kE_c0_0
    location: [[40.0, 9.6, 20.0], [0, 1, 0], 90]
  - part: //pub/universe/lego/ldraw/Brick:3004
    name: kS_c1_0
    location: [[4.0, 19.2, 0.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3010
    name: kS_c1_1
    location: [[28.0, 19.2, 0.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3004
    name: kN_c1_0
    location: [[4.0, 19.2, 40.0], [0, 1, 0], 0]
  - part: //pub/universe/lego/ldraw/Brick:3010
    name: kN_c1_1
    location: [[28.0, 19.2, 40.0], [0, 1, 0], 0]
  {% for name, x, z in [
      ["kW_c1_0", 0.0, 12.0],
      ["kW_c1_1", 0.0, 28.0],
      ["kE_c1_0", 40.0, 12.0],
      ["kE_c1_1", 40.0, 28.0],
    ] %}
  - part: //pub/universe/lego/ldraw/Brick:3004
    name: {{ name }}
    location: [[{{ x }}, 19.2, {{ z }}], [0, 1, 0], 90]
  {% endfor %}
