    name: inner-l
  - assembly: f1/motor-unit
    name: motor-unit
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-motor-l1-pin-left
      withParams:
        turnZ: 180
      name: inner-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4-top
  - part: //pub/universe/lego/ldraw/Technic:32525
