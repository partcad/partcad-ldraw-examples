# f1/battery - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The Power Functions battery box, with the pins in its end holes that the side frames go onto.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-l-lo-front
  - part: //pub/universe/lego/ldraw/Electric:58119
    name: battery-box
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0
      name: pin-l-lo-front
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-l-lo-back
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h2
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-l-up-front
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-l-up-back
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h3
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-r-lo-front
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 180
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h30
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-r-lo-back
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 180
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h32
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-r-up-front
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 180
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h31
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-r-up-back
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 180
      name: battery-box
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h33
