# f1/tub - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The tub: both side frames, the battery box between them, the pivot the drivetrain swings on, and the airbox.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - assembly: f1/side-frame-left
    name: side-frame-left
  - assembly: f1/battery
    name: battery
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-l-lo-front-pin-left
      withParams:
        turnZ: 180
      name: side-frame-left
      to: //pub/universe/lego:technic-pin-hole
      toInstance: rail-lo-hole-h5-top
  - assembly: f1/side-frame-right
    name: side-frame-right
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: rail-lo-hole-h5-bottom
      withParams:
        turnZ: 180
      name: battery
      to: //pub/universe/lego:technic-pin
      toInstance: pin-r-lo-front-pin-right
  - part: //pub/universe/lego/ldraw/Technic:3708
    name: pivot
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: left
      withParams:
        moveZ: 4
      name: side-frame-left
      to: //pub/universe/lego:technic-pin-hole
      toInstance: rail-lo-hole-h0-bottom
      toParams:
        turnZ: -180
  - part: //pub/universe/lego/ldraw/Technic:3713
    name: pivot-bush-l
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -4
      name: pivot
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:3713
    name: pivot-bush-r1
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a1
      withParams:
        moveZ: -12
      name: pivot
      to: //pub/universe/lego:technic-axle
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:3713
    name: pivot-bush-r2
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a1
      withParams:
        moveZ: -4
      name: pivot
      to: //pub/universe/lego:technic-axle
      toInstance: right
  - assembly: f1/airbox
    name: airbox
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: axle-l-axle-left
      name: side-frame-left
      to: //pub/universe/lego:technic-pin-hole
      toInstance: post-hole-h5-bottom
      toParams:
        turnZ: -180
