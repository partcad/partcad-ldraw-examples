# f1/rear-wing - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The rear wing: an axle through the shock towers, two slats on edge between two endplates, on two pylons.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: f1/3708-black
    name: axle
  - part: f1/6536-stone
    name: block-l
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -20
      name: axle
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: f1/6536-stone
    name: block-r
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -68
      name: axle
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: f1/2780-black
    name: pin-pylon-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: block-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1
  - part: f1/32524-red
    name: pylon-l
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0-top
      withParams:
        turnZ: 90
      name: pin-pylon-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-slat-lo-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: pylon-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h5-bottom
  - part: f1/32278-red
    name: slat-lo
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-top
      name: pin-slat-lo-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-slat-hi-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: pylon-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h6-bottom
  - part: f1/32278-red
    name: slat-hi
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-top
      name: pin-slat-hi-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-slat-lo-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: slat-lo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h10-top
  - part: f1/32524-red
    name: pylon-r
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h5-bottom
      withParams:
        turnZ: -90
      name: pin-slat-lo-r
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-slat-hi-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: pylon-r
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h6-bottom
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [slat-hi]
  - part: f1/2780-black
    name: pin-pylon-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: pylon-r
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0-top
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [block-r]
  - part: f1/2780-black
    name: pin-endplate-l-lo
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: slat-lo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0-bottom
  - part: f1/32316-red
    name: endplate-l
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h3-top
      withParams:
        turnZ: 90
      name: pin-endplate-l-lo
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-endplate-l-hi
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: endplate-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4-top
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [slat-hi]
  - part: f1/2780-black
    name: pin-endplate-r-lo
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: slat-lo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h14-bottom
  - part: f1/32316-red
    name: endplate-r
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h3-top
      withParams:
        turnZ: 90
      name: pin-endplate-r-lo
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-endplate-r-hi
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: endplate-r
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4-top
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [slat-hi]
