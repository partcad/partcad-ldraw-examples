# f1/steering - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The servo, its arm and the track rod.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-servo-1
    color: "#1B2A34" # LDraw 0, Black
  - assembly: //pub/universe/lego/ldraw/Electric:99498
    name: servo
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h10
      withParams:
        turnZ: 180
      name: pin-servo-1
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-servo-2
    color: "#1B2A34" # LDraw 0, Black
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -180
      name: servo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h11
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-servo-3
    color: "#1B2A34" # LDraw 0, Black
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: servo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-servo-4
    color: "#1B2A34" # LDraw 0, Black
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: servo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1
  - part: //pub/universe/lego/ldraw/Technic:3704
    name: output
    color: "#1B2A34" # LDraw 0, Black
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: right
      name: servo
      to: //pub/universe/lego:technic-axle-hole
      toInstance: a1
  - part: //pub/universe/lego/ldraw/Technic:11478
    name: arm
    color: "#1B2A34" # LDraw 0, Black
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a2
      withParams:
        moveZ: -4
      name: output
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:3704
    name: arm-tip
    color: "#1B2A34" # LDraw 0, Black
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: left
      name: arm
      to: //pub/universe/lego:technic-axle-hole
      toInstance: a3
  - part: //pub/universe/lego/ldraw/Technic:32278
    name: track-rod
    color: "#B40000" # LDraw 4, Red
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h7-bottom
      withParams:
        turnZ: -90
        moveZ: -4
      name: arm-tip
      to: //pub/universe/lego:technic-axle
      toInstance: left
