# f1/front-right - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The right front corner: double wishbones, a kingpin, the knuckle, the wheel and a shock.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-lower-in
    color: "#969696" # LDraw 71, Light_Bluish_Grey
  - part: //pub/universe/lego/ldraw/Technic:32316
    name: wishbone-lower
    color: "#B40000" # LDraw 4, Red
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0-bottom
      name: pin-lower-in
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-lower-out
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: right
      name: wishbone-lower
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4-top
  - part: //pub/universe/lego/ldraw/Technic:6536
    name: kingpin-lower
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0
      withParams:
        turnZ: -180
      name: pin-lower-out
      to: //pub/universe/lego:technic-pin
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:4519
    name: kingpin
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: left
      name: kingpin-lower
      to: //pub/universe/lego:technic-axle-hole
      toInstance: a1
  - part: //pub/universe/lego/ldraw/Technic:6536
    name: kingpin-upper
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a1
      withParams:
        moveZ: -16
      name: kingpin
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-upper-out
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: right
      withParams:
        turnZ: -180
      name: kingpin-upper
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0
  - part: //pub/universe/lego/ldraw/Technic:32316
    name: wishbone-upper
    color: "#B40000" # LDraw 4, Red
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-top
      name: pin-upper-out
      to: //pub/universe/lego:technic-pin
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-upper-in
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: wishbone-upper
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0-bottom
  - part: //pub/universe/lego/ldraw/Technic:32557
    name: knuckle
    color: "#646464" # LDraw 72, Dark_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h1
      withParams:
        turnZ: 90
        moveZ: -8
