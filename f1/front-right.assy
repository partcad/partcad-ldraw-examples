      toInstance: h6
  - part: //pub/universe/lego/ldraw/Technic:3713
    name: bush
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -8
      name: stub-axle
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - assembly: //pub/universe/lego/ldraw/Wheel:41896c01
    name: wheel
    color: "#969696" # LDraw 71, Light_Bluish_Grey
    connect:
      with: //pub/universe/lego:technic-axle-hole
