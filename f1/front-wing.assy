# f1/front-wing - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The front wing: two slats on edge between two endplates, hung from the nose on two pylons.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-pylon-l
  - part: //pub/universe/lego/ldraw/Technic:32316
    name: pylon-l
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-bottom
      withParams:
        turnZ: -90
      name: pin-pylon-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-slat-lo-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: pylon-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0-top
  - part: //pub/universe/lego/ldraw/Technic:32278
    name: slat-lo
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-bottom
      name: pin-slat-lo-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-slat-hi-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: pylon-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1-top
  - part: //pub/universe/lego/ldraw/Technic:32278
    name: slat-hi
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-bottom
      name: pin-slat-hi-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-slat-lo-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: slat-lo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h10-bottom
  - part: //pub/universe/lego/ldraw/Technic:32316
    name: pylon-r
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0-top
      withParams:
        turnZ: 90
      name: pin-slat-lo-r
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-slat-hi-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: pylon-r
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1-top
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [slat-hi]
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-pylon-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: pylon-r
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4-bottom
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-endplate-l-lo
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: slat-lo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0-top
  - part: //pub/universe/lego/ldraw/Technic:32523
    name: endplate-l
