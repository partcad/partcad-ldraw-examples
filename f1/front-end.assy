# f1/front-end - a piece of the F1 car, generated by tools/gen_f1.py.
#
# Everything ahead of the battery: the front frame, both front corners, the steering, the nose and the front wing.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - assembly: f1/front-frame
    name: front-frame
  - assembly: f1/steering
    name: steering
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-servo-1-pin-left
      withParams:
        turnZ: -180
      name: front-frame
      to: //pub/universe/lego:technic-pin-hole
      toInstance: servo-rail-r-hole-h0-bottom
  - assembly: f1/front-right
    name: front-right
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-lower-in-pin-left
      withParams:
        turnZ: 90
      name: front-frame
      to: //pub/universe/lego:technic-pin-hole
      toInstance: bulk-r-hole-h0-top
  - assembly: f1/front-left
    name: front-left
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-lower-in-pin-left
      withParams:
        turnZ: 90
      name: front-frame
      to: //pub/universe/lego:technic-pin-hole
      toInstance: bulk-l-hole-h0-top
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-shock-top-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: front-frame
      to: //pub/universe/lego:technic-pin-hole
      toInstance: shock-beam-hole-h2-top
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-shock-top-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: front-frame
      to: //pub/universe/lego:technic-pin-hole
      toInstance: shock-beam-hole-h8-top
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-track-rod-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: steering
      to: //pub/universe/lego:technic-pin-hole
      toInstance: track-rod-hole-h0-bottom
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-track-rod-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: steering
      to: //pub/universe/lego:technic-pin-hole
      toInstance: track-rod-hole-h14-bottom
  - assembly: f1/nose
    name: nose
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: axle-axle-left
      withParams:
        moveZ: 4
      name: front-frame
      to: //pub/universe/lego:technic-pin-hole
      toInstance: nose-ext-l-hole-h6-bottom
      toParams:
        turnZ: -90
  - assembly: f1/front-wing
    name: front-wing
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-pylon-l-pin-left
      name: nose
      to: //pub/universe/lego:technic-pin-hole
      toInstance: beam-hole-h1-top
