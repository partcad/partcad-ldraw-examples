      withInstance: left
      withParams:
        turnZ: -90
      name: xl-motor
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h9
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-bracket-1
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: xl-motor
