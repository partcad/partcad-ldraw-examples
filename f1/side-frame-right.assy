# f1/side-frame-right - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The right side frame: the two rails, the post at the back and the shock tower over it.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: f1/32278-red
    name: rail-lo
  - part: f1/2780-black
    name: pin-post-lo
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -180
      name: rail-lo
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1-bottom
  - part: f1/32524-red
    name: post
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0-top
      withParams:
        turnZ: 90
      name: pin-post-lo
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-post-up
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: post
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h2-top
  - part: f1/32278-red
    name: rail-up
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h1-bottom
      withParams:
        turnZ: 180
      name: pin-post-up
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-post-tower
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: post
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h6-top
  - part: f1/41239-red
    name: tower
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h12-bottom
      withParams:
        turnZ: 180
      name: pin-post-tower
      to: //pub/universe/lego:technic-pin
      toInstance: right
