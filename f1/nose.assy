# f1/nose - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The nose: a cross axle between the nose rails, a crossbeam, and the nose cone.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: //pub/universe/lego/ldraw/Technic:3708
    name: axle
  - part: //pub/universe/lego/ldraw/Technic:6536
    name: block-l
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -28
      name: axle
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:6536
    name: block-r
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -60
      name: axle
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-beam-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: block-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1
  - part: //pub/universe/lego/ldraw/Technic:40490
    name: beam
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h2-bottom
      name: pin-beam-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-beam-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: beam
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h6-bottom
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [block-r]
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-cone-r-1
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: beam
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h5-top
  - part: //pub/universe/lego/ldraw/Technic:64681
    name: cone-r
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h6
      withParams:
        turnZ: -90
      name: pin-cone-r-1
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-cone-r-2
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: cone-r
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [beam]
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-cone-l-1
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: beam
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h3-top
  - part: //pub/universe/lego/ldraw/Technic:64393
    name: cone-l
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0
      withParams:
        turnZ: -90
      name: pin-cone-l-1
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-cone-l-2
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: cone-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h8
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [beam]
