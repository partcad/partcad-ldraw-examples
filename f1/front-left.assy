# f1/front-left - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The left front corner: double wishbones, a kingpin, the knuckle, the wheel and a shock.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: f1/3673-stone
    name: pin-lower-in
  - part: f1/32316-red
    name: wishbone-lower
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h4-bottom
      name: pin-lower-in
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/3673-stone
    name: pin-lower-out
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: right
      name: wishbone-lower
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0-top
  - part: f1/6536-stone
    name: kingpin-lower
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0
      name: pin-lower-out
      to: //pub/universe/lego:technic-pin
      toInstance: left
  - part: f1/4519-stone
    name: kingpin
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: left
      name: kingpin-lower
      to: //pub/universe/lego:technic-axle-hole
      toInstance: a0
  - part: f1/6536-stone
    name: kingpin-upper
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -16
      name: kingpin
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: f1/3673-stone
    name: pin-upper-out
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: right
      name: kingpin-upper
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0
  - part: f1/32316-red
    name: wishbone-upper
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0-top
      name: pin-upper-out
      to: //pub/universe/lego:technic-pin
      toInstance: left
  - part: f1/3673-stone
    name: pin-upper-in
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: wishbone-upper
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h4-bottom
  - part: f1/32557-dark-stone
    name: knuckle
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h1
      withParams:
        turnZ: -90
        moveZ: -8
      name: kingpin
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - part: f1/3705-black
    name: stub-axle
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: left
      name: knuckle
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h7
  - part: f1/3713-stone
    name: bush
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      withParams:
        moveZ: -8
      name: stub-axle
      to: //pub/universe/lego:technic-axle
      toInstance: left
  - assembly: f1/41896c01-stone
    name: wheel
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a1
      name: stub-axle
      to: //pub/universe/lego:technic-axle
      toInstance: right
  - part: f1/3673-stone
    name: pin-shock
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: right
      name: wishbone-upper
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h3-top
  - assembly: f1/76320-f2-dark-stone
    name: shock
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h2
      withParams:
        turnZ: 90
      name: pin-shock
      to: //pub/universe/lego:technic-pin
      toInstance: left
