# The Formula 1 car: Power Functions XL motor through a differential, a
# servo on the steering, the battery box and the IR receiver. Generated by
# tools/gen_f1.py.
#
# The car is its pieces, each joined to the one it hangs from through a
# port the piece externalizes ('map:' in partcad.yaml), and the few pins that
# join two pieces and belong to neither. The container's placement is the
# chassis's first beam's own pose, turned from the parts' Y-up frame into
# PartCAD's Z-up world: nose towards -Y, the ground at z = 0.
name: car
location: [[-48, -136, 40], [1, 1, -1], 120]
links:
  - assembly: f1/chassis
    name: chassis
  - assembly: f1/battery
    name: battery
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-l-lo-front-pin-left
      withParams:
        turnZ: -180
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: rail-lo-l-hole-h5-top
  - assembly: f1/airbox
    name: airbox
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-1-pin-left
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: airbox-beam-hole-h3-bottom
  - assembly: f1/drivetrain
    name: drivetrain
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: inner-l-hole-h10-bottom
      withParams:
        turnZ: -180
        moveZ: -12
      name: chassis
      to: //pub/universe/lego:technic-axle
      toInstance: pivot-axle-left
  - assembly: f1/front-right
    name: front-right
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-lower-in-pin-left
      withParams:
        turnZ: 90
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: bulk-r-hole-h0-top
  - assembly: f1/front-left
    name: front-left
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-lower-in-pin-left
      withParams:
        turnZ: 90
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: bulk-l-hole-h0-top
  - assembly: f1/steering
    name: steering
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-servo-1-pin-left
      withParams:
        turnZ: -180
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: servo-rail-r-hole-h0-bottom
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-front-shock-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: shock-beam-hole-h2-top
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-front-shock-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: shock-beam-hole-h8-top
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-track-rod-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: steering
      to: //pub/universe/lego:technic-pin-hole
      toInstance: track-rod-hole-h0-bottom
  - part: //pub/universe/lego/ldraw/Technic:3673
    name: pin-track-rod-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: steering
      to: //pub/universe/lego:technic-pin-hole
      toInstance: track-rod-hole-h14-bottom
  - assembly: f1/nose
    name: nose
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: axle-axle-left
      withParams:
        moveZ: 4
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: nose-ext-l-hole-h6-bottom
      toParams:
        turnZ: -90
  - assembly: f1/front-wing
    name: front-wing
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-pylon-l-pin-left
      name: nose
      to: //pub/universe/lego:technic-pin-hole
      toInstance: beam-hole-h1-top
  - assembly: f1/rear-wing
    name: rear-wing
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-pylon-l-pin-left
      withParams:
        turnZ: 90
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: wing-block-l-hole-h1
  - assembly: f1/sidepod
    name: sidepod-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-front-pin-right
      withParams:
        turnZ: 180
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: rail-up-l-hole-h11-bottom
  - assembly: f1/sidepod
    name: sidepod-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: pin-front-pin-right
      withParams:
        turnZ: 180
      name: chassis
      to: //pub/universe/lego:technic-pin-hole
      toInstance: rail-up-r-hole-h3-top
