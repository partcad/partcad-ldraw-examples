# airbox - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The Power Functions IR receiver, sitting where an F1 car has its airbox.
#
# The first part is the piece's own origin, and says nothing: where the
# piece goes is for f1.assy to decide. Every other part is joined through
# its ports to a part before it.
links:
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-1
  - part: //pub/universe/lego/ldraw/Electric:58123
    name: ir-receiver
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h2
      withParams:
        turnZ: 90
      name: pin-1
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: //pub/universe/lego/ldraw/Technic:2780
    name: pin-2
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: ir-receiver
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0
