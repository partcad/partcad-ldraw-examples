# f1/airbox - a piece of the F1 car, generated by tools/gen_f1.py.
#
# The Power Functions IR receiver on a crossbeam, and the cross blocks the rear posts carry it by.
#
# Built on its own and then fitted where it goes: its first item is its
# origin and says nothing, and everything else in it is joined through its
# ports to something before it. What the piece is joined by from outside
# is what 'map:' externalizes in partcad.yaml.
links:
  - part: f1/3704-black
    name: axle-l
  - part: f1/6536-stone
    name: block-l
    connect:
      with: //pub/universe/lego:technic-axle-hole
      withInstance: a0
      name: axle-l
      to: //pub/universe/lego:technic-axle
      toInstance: right
  - part: f1/2780-black
    name: pin-beam-l
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: -90
      name: block-l
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h1
  - part: f1/40490-red
    name: beam
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0-top
      name: pin-beam-l
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-beam-r
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: beam
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h8-top
  - part: f1/6536-stone
    name: block-r
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h0
      withParams:
        turnZ: 90
      name: pin-beam-r
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/3704-black
    name: axle-r
    connect:
      with: //pub/universe/lego:technic-axle
      withInstance: left
      name: block-r
      to: //pub/universe/lego:technic-axle-hole
      toInstance: a0
  - part: f1/2780-black
    name: pin-rx-1
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      name: beam
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h3-bottom
  - part: f1/58123-stone
    name: ir-receiver
    connect:
      with: //pub/universe/lego:technic-pin-hole
      withInstance: h2
      withParams:
        turnZ: 90
      name: pin-rx-1
      to: //pub/universe/lego:technic-pin
      toInstance: right
  - part: f1/2780-black
    name: pin-rx-2
    connect:
      with: //pub/universe/lego:technic-pin
      withInstance: left
      withParams:
        turnZ: 90
      name: ir-receiver
      to: //pub/universe/lego:technic-pin-hole
      toInstance: h0
      # its other end snaps into these as well (see snap_in_elsewhere)
      interferes: [beam]
