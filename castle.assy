# A gothic castle in LEGO, generated by tools/gen_castle.py.
#
# Spired towers along the curtain wall and at its corners, a twin-towered
# gatehouse over a pointed arch, buttresses with pinnacles between the
# bays, and a tall turreted keep. Parts are LDraw parts from
# //pub/universe/lego, placed on LEGO's own grid: 8 mm stud pitch,
# 9.6 mm brick height.
#
# The container rotation takes the parts' native Y-up frame into PartCAD's
# Z-up world, so front/top/right/iso mean what they say.
name: castle
location: [[0, 0, 0], [1, 0, 0], 90]
links:
  - assembly: castle/wall-gate
    name: wallS
    location: [[28.0, 9.6, 0.0], [0, 1, 0], 0]
  - assembly: castle/wall
    name: wallN
    location: [[28.0, 9.6, 200.0], [0, 1, 0], 0]
  - assembly: castle/wall
    name: wallW
    location: [[0.0, 9.6, 28.0], [0, 1, 0], 270]
  - assembly: castle/wall
    name: wallE
    location: [[200.0, 9.6, 28.0], [0, 1, 0], 270]
  {% for name, x, z in [
      ["towerSW", 4.0, 4.0],
      ["towerSE", 196.0, 4.0],
      ["towerNW", 4.0, 196.0],
      ["towerNE", 196.0, 196.0],
    ] %}
  - assembly: castle/tower-corner
    name: {{ name }}
    location: [[{{ x }}, 9.6, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, x, z in [
      ["spireSW", 4.0, 4.0],
      ["spireSE", 196.0, 4.0],
      ["spireNW", 4.0, 196.0],
      ["spireNE", 196.0, 196.0],
    ] %}
  - assembly: castle/spire
    name: {{ name }}
    location: [[{{ x }}, 163.2, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, x, z in [
      ["towerN", 100.0, 212.0],
      ["towerW", -12.0, 100.0],
      ["towerE", 212.0, 100.0],
    ] %}
  - assembly: castle/tower-mural
    name: {{ name }}
    location: [[{{ x }}, 9.6, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, x, z in [
      ["spireN", 100.0, 212.0],
      ["spireW", -12.0, 100.0],
      ["spireE", 212.0, 100.0],
    ] %}
  - assembly: castle/spire
    name: {{ name }}
    location: [[{{ x }}, 134.4, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  - assembly: castle/tower-gate
    name: gateW
    location: [[68.0, 9.6, -12.0], [0, 1, 0], 0]
  - assembly: castle/tower-gate
    name: gateE
    location: [[132.0, 9.6, -12.0], [0, 1, 0], 0]
  - assembly: castle/spire
    name: gateSpireW
    location: [[68.0, 144.0, -12.0], [0, 1, 0], 0]
  - assembly: castle/spire
    name: gateSpireE
    location: [[132.0, 144.0, -12.0], [0, 1, 0], 0]
  {% for name, x, z in [
      ["buttS4", 32.0, -8.0],
      ["buttS6", 48.0, -8.0],
      ["buttS19", 152.0, -8.0],
      ["buttS21", 168.0, -8.0],
      ["buttN5", 40.0, 208.0],
      ["buttN8", 64.0, 208.0],
      ["buttN17", 136.0, 208.0],
      ["buttN20", 160.0, 208.0],
      ["buttW5", -8.0, 40.0],
      ["buttE5", 208.0, 40.0],
      ["buttW8", -8.0, 64.0],
      ["buttE8", 208.0, 64.0],
      ["buttW17", -8.0, 136.0],
      ["buttE17", 208.0, 136.0],
      ["buttW20", -8.0, 160.0],
      ["buttE20", 208.0, 160.0],
    ] %}
  - assembly: castle/buttress
    name: {{ name }}
    location: [[{{ x }}, 9.6, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, y in [
      ["keepC0", 9.6],
      ["keepC2", 28.8],
      ["keepC8", 86.4],
      ["keepC14", 144.0],
    ] %}
  - assembly: castle/keep-courses
    name: {{ name }}
    location: [[92.0, {{ y }}, 80.0], [0, 1, 0], 0]
  {% endfor %}
  - assembly: castle/keep-courses-lancets
    name: keepL4
    location: [[84.0, 48.0, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-courses-lancets
    name: keepL10
    location: [[84.0, 105.6, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-courses-lancet-head
    name: keepH6
    location: [[84.0, 67.2, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-courses-lancet-head
    name: keepH12
    location: [[84.0, 124.8, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-course-last
    name: keepLast
    location: [[92.0, 163.2, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-head
    name: keepHead
    location: [[96.0, 172.8, 80.0], [0, 1, 0], 0]
