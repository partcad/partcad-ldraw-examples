# A gothic castle in LEGO, generated by tools/gen_castle.py.
#
# Spired towers along the curtain wall and at its corners, a twin-towered
# gatehouse over a pointed arch, buttresses with pinnacles between the
# bays, and a tall turreted keep. Parts are LDraw parts from
# //pub/universe/lego, placed on LEGO's own grid: 8 mm stud pitch,
# 9.6 mm brick height.
#
# The container rotation takes the parts' native Y-up frame into PartCAD's
# Z-up world, so front/top/right/iso mean what they say.
name: castle
location: [[0, 0, 0], [1, 0, 0], 90]
links:
  - assembly: castle/wall-gate
    name: wallS
    location: [[16.0, 0.0, 0.0], [0, 1, 0], 0]
  - assembly: castle/wall
    name: wallN
    location: [[16.0, 0.0, 200.0], [0, 1, 0], 0]
  - assembly: castle/wall
    name: wallW
    location: [[0.0, 0.0, 16.0], [0, 1, 0], 270]
  - assembly: castle/wall
    name: wallE
    location: [[200.0, 0.0, 16.0], [0, 1, 0], 270]
  {% for name, x, z in [
      ["towerSW", 0.0, 0.0],
      ["towerSE", 192.0, 0.0],
      ["towerNW", 0.0, 192.0],
      ["towerNE", 192.0, 192.0],
    ] %}
  - assembly: castle/tower-corner
    name: {{ name }}
    location: [[{{ x }}, 0.0, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, x, z in [
      ["spireSW", 0.0, 0.0],
      ["spireSE", 192.0, 0.0],
      ["spireNW", 0.0, 192.0],
      ["spireNE", 192.0, 192.0],
    ] %}
  - assembly: castle/spire
    name: {{ name }}
    location: [[{{ x }}, 144.0, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, x, z in [
      ["towerN", 96.0, 208.0],
      ["towerW", -16.0, 96.0],
      ["towerE", 208.0, 96.0],
    ] %}
  - assembly: castle/tower-mural
    name: {{ name }}
    location: [[{{ x }}, 0.0, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, x, z in [
      ["spireN", 96.0, 208.0],
      ["spireW", -16.0, 96.0],
      ["spireE", 208.0, 96.0],
    ] %}
  - assembly: castle/spire
    name: {{ name }}
    location: [[{{ x }}, 115.2, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  - assembly: castle/tower-gate
    name: gateW
    location: [[64.0, 0.0, -16.0], [0, 1, 0], 0]
  - assembly: castle/tower-gate
    name: gateE
    location: [[128.0, 0.0, -16.0], [0, 1, 0], 0]
  - assembly: castle/spire
    name: gateSpireW
    location: [[64.0, 124.8, -16.0], [0, 1, 0], 0]
  - assembly: castle/spire
    name: gateSpireE
    location: [[128.0, 124.8, -16.0], [0, 1, 0], 0]
  {% for name, x, z in [
      ["buttS4", 32.0, -8.0],
      ["buttS6", 48.0, -8.0],
      ["buttS19", 152.0, -8.0],
      ["buttS21", 168.0, -8.0],
      ["buttN5", 40.0, 208.0],
      ["buttN8", 64.0, 208.0],
      ["buttN17", 136.0, 208.0],
      ["buttN20", 160.0, 208.0],
      ["buttW5", -8.0, 40.0],
      ["buttE5", 208.0, 40.0],
      ["buttW8", -8.0, 64.0],
      ["buttE8", 208.0, 64.0],
      ["buttW17", -8.0, 136.0],
      ["buttE17", 208.0, 136.0],
      ["buttW20", -8.0, 160.0],
      ["buttE20", 208.0, 160.0],
    ] %}
  - assembly: castle/buttress
    name: {{ name }}
    location: [[{{ x }}, 0.0, {{ z }}], [0, 1, 0], 0]
  {% endfor %}
  {% for name, y in [
      ["keepC0", 0.0],
      ["keepC2", 19.2],
      ["keepC8", 76.8],
      ["keepC14", 134.4],
    ] %}
  - assembly: castle/keep-courses
    name: {{ name }}
    location: [[80.0, {{ y }}, 80.0], [0, 1, 0], 0]
  {% endfor %}
  - assembly: castle/keep-courses-lancets
    name: keepL4
    location: [[80.0, 38.4, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-courses-lancets
    name: keepL10
    location: [[80.0, 96.0, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-courses-lancet-head
    name: keepH6
    location: [[80.0, 57.6, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-courses-lancet-head
    name: keepH12
    location: [[80.0, 115.2, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-course-last
    name: keepLast
    location: [[80.0, 153.6, 80.0], [0, 1, 0], 0]
  - assembly: castle/keep-head
    name: keepHead
    location: [[80.0, 0.0, 80.0], [0, 1, 0], 0]
